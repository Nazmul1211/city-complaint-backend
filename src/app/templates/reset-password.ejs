<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Changed</title>
</head>
<body style="margin: 0; padding: 32px 16px; background-color: #f4f7fb; font-family: Arial, sans-serif; color: #1f2937;">
    <div style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
        <div style="padding: 28px 32px; background-color: #0f766e; color: #ffffff;">
            <h1 style="margin: 0; font-size: 24px;">Password changed successfully</h1>
        </div>
        <div style="padding: 32px;">
            <p style="margin: 0 0 16px; font-size: 16px;">Hello <%= name %>,</p>
            <p style="margin: 0 0 20px; line-height: 1.6;">Your password has been changed successfully.</p>
            <div style="padding: 16px; background-color: #ecfdf5; border-left: 4px solid #0f766e; color: #115e59; line-height: 1.6;">
                You can now sign in using your new password.
            </div>
            <p style="margin: 24px 0 0; color: #6b7280; font-size: 14px; line-height: 1.6;">If you did not make this change, please contact support immediately.</p>
        </div>
    </div>
</body>
</html>