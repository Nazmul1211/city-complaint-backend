# Application & Database Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/city_complaint_db?sslmode=require"
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Password Hashing
BCRYPT_SALT_ROUND=10

# Super Admin Seed
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="superadmin@gmail.com"
SUPER_ADMIN_PASSWORD="Super@Admin123456"

# Tester Accounts
TESTER_ADMIN_NAME="Tester Admin"
TESTER_ADMIN_EMAIL="testeradmin@gmail.com"
TESTER_ADMIN_PASSWORD="Tester@Admin123456"
TESTER_CITIZEN_NAME="Tester Citizen"
TESTER_CITIZEN_EMAIL="testercitizen@gmail.com"
TESTER_CITIZEN_PASSWORD="Tester@Citizen123456"

# Redis Cache & Sessions
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email
SMTP_USER=your_email@gmail.com
EMAIL_SENDER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# bKash Tokenized Checkout (Sandbox)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
