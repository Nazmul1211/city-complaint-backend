model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  code        String   @unique
  description String?

  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations

  members     DepartmentMember[]
  categories  Category[]

  @@index([isActive])
}