model User {
  id String @id @default(uuid()) @db.Uuid

  name     String
  email    String  @unique
  password String?
  phone    String? @unique

  googleId String? @unique
  githubId String? @unique

  authProvider AuthProvider @default(CREDENTIAL)
  role         UserRole     @default(CITIZEN)
  status       UserStatus   @default(PENDING_VERIFICATION)

  emailVerified Boolean @default(false)

  avatarUrl      String?
  avatarPublicId String?

  needPasswordChange Boolean @default(false)

  citizen Citizen?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentMemberships DepartmentMember[]

  routedRequests RequestDepartmentRoute[] @relation("RouteByUser")

  assignmentsMade     RequestAssignment[] @relation("AssignmentByUser")
  assignmentsReceived RequestAssignment[] @relation("AssignmentToUser")

  statusChanges RequestStatusHistory[] @relation("StatusChangedByUser")

  workUpdates WorkUpdate[] @relation("WorkUpdateByUser")

  uploadedAttachments MediaAttachment[] @relation("AttachmentByUser")

  notifications Notification[] @relation("NotificationsForUser")

  auditLogs AuditLog[]

  @@map("users")
}
